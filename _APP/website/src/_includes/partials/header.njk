<div class="topbar">
  <div class="container topbar-inner">
    <span>{{ site.hours }}</span>
    <a href="/remote-help/">Need help right now? Try remote help</a>
    <a href="tel:{{ site.phoneLink }}" class="topbar-phone">{{ site.phone }}</a>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="{{ site.name }} home">
      {% include "partials/logo.njk" %}
      <span class="brand-name">{{ site.shortName or site.name }}<small>Tech Rescue</small></span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bars" aria-hidden="true"></span><span class="visually-hidden">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        <li class="has-sub">
          <button class="sub-toggle" aria-expanded="false">Services</button>
          <ul class="sub-menu">
            <li><a href="/#help">Home tech help</a></li>
            {%- for s in services %}
            <li><a href="{{ s.url }}"{% if page.url == s.url %} aria-current="page"{% endif %}>{{ s.label }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        <li><a href="/#pricing">Pricing</a></li>
        <li><a href="/areas/"{% if page.url == "/areas/" %} aria-current="page"{% endif %}>Areas</a></li>
        <li><a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a></li>
        <li><a href="/contact/"{% if page.url == "/contact/" %} aria-current="page"{% endif %}>Contact</a></li>
        <li class="nav-cta"><a href="/contact/#book" class="btn btn-accent">Book a visit</a></li>
      </ul>
    </nav>
  </div>
</header>
<div class="ticker" aria-hidden="true">
  {%- set tickerItems = ["Home visits across East Sussex", "Remote help anywhere in the UK", (prices.hourly | gbp) + " an hour", prices.diagnosis, prices.noFixNoFee, "Price agreed before I start", site.dbs, "Eastbourne · Bexhill · Hastings"] %}
  <div class="ticker-track">
    {%- for g in [1, 2] %}<div class="ticker-group">{% for t in tickerItems %}<span>{{ t }}</span><span class="star">★</span>{% endfor %}</div>{% endfor %}
  </div>
</div>
