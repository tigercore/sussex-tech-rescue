---
layout: layouts/base.njk
permalink: /areas/
title: Areas I cover in East Sussex
description: I visit homes and businesses across Eastbourne, Bexhill, Hastings, St Leonards, Polegate, Hailsham, Pevensey, Westham, Willingdon and Seaford.
---
<section class="page-hero">
  <div class="container narrow">
    <p class="eyebrow">Areas I cover</p>
    <h1>Areas I cover</h1>
    <p class="lede">I'm based in {{ site.base }} and visit homes and businesses across the surrounding towns and villages. {{ prices.travel }}</p>
  </div>
</section>
<section class="section section-tint" aria-labelledby="map-heading">
  <div class="container">
    <h2 id="map-heading">Coverage map</h2>
    <p class="section-lede">Each circle marks a town I cover. Tap one to see that town's page.</p>
    <div id="area-map" class="area-map" role="region" aria-label="Map of the towns I cover">
      <noscript><p>The map needs JavaScript. All the towns I cover are listed below.</p></noscript>
    </div>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="card-grid">
      {%- for t in towns %}
      <a class="card card-link" href="/computer-help-{{ t.slug }}/">
        <h3>{{ t.name }}</h3>
        <p class="small">{{ t.postcodes }} · {{ t.travel }}</p>
        <p>{{ t.areas | join(", ") }}</p>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
<section class="section section-tint">
  <div class="container narrow prose">
    <h2>Not on the list?</h2>
    <p>If you're in a village nearby, such as Herstmonceux, East Dean, Friston, Ninfield or Battle, just ask. I can often fit you in, and I'll let you know if there's a small travel charge before booking.</p>
    <p>Further afield? <a href="/remote-help/">Remote help</a> works anywhere in the UK.</p>
  </div>
</section>
{% include "partials/booking.njk" %}

<link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
<script src="/assets/vendor/leaflet/leaflet.js"></script>
<script>
  // Coverage map: OpenStreetMap tiles, no API key and no cookies. Town positions live in _data/towns.json.
  (function () {
    var el = document.getElementById("area-map");
    if (!el || !window.L) return;
    var towns = [{% for t in towns %}{ name: {{ t.name | dump | safe }}, slug: "{{ t.slug }}", lat: {{ t.lat }}, lng: {{ t.lng }} }{% if not loop.last %}, {% endif %}{% endfor %}];
    var map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    var bounds = [];
    var wide = el.offsetWidth > 600; // on phones, names show on tap instead of crowding the map
    towns.forEach(function (t) {
      var circle = L.circle([t.lat, t.lng], { radius: 2200, color: "#1f6577", weight: 2, fillColor: "#9cc7cf", fillOpacity: 0.45 }).addTo(map);
      // Short names, nudged apart where towns sit close together
      var label = t.name.replace(/-on-Sea$/, "").split(" and ")[0];
      var dir = { westham: "left", pevensey: "right", "st-leonards": "left", hastings: "right", willingdon: "left", polegate: "left" }[t.slug] || "center";
      circle.bindTooltip(label, { permanent: wide, direction: wide ? dir : "top", className: "map-label" });
      circle.on("click", function () { window.location.href = "/computer-help-" + t.slug + "/"; });
      bounds.push([t.lat, t.lng]);
    });
    map.fitBounds(bounds, { padding: [30, 30] });
  })();
</script>
