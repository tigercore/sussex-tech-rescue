---
layout: layouts/base.njk
---
<section class="hero hero-service">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{{ eyebrow or site.name }}</p>
      <h1>{{ heading or title }}</h1>
      <p class="lede">{{ lede }}</p>
      <div class="btn-row">
        <a href="tel:{{ site.phoneLink }}" class="btn btn-primary">Call {{ site.phone }}</a>
        <a href="#book" class="btn btn-accent">{{ ctaLabel or "Book a visit" }}</a>
      </div>
      {% if chips %}<ul class="chips">{% for c in chips %}<li>{{ c }}</li>{% endfor %}{% if showDbs and site.dbs %}<li>{{ site.dbs }}</li>{% endif %}</ul>{% endif %}
    </div>
  </div>
</section>

{% if problems %}
<section class="section" aria-labelledby="problems-heading">
  <div class="container">
    <h2 id="problems-heading">{{ problemsHeading or "Sound familiar?" }}</h2>
    <div class="card-grid">
      {%- for p in problems %}
      <article class="card">
        <span class="card-icon">{% icon p.icon %}</span>
        <h3>{{ p.title }}</h3>
        <p>{{ p.text }}</p>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section section-tint">
  <div class="container narrow prose">
    {{ content | safe }}
  </div>
</section>

{% if showPricing != false %}{% include "partials/pricing.njk" %}{% endif %}
{% include "partials/reviews.njk" %}
{% include "partials/faqs.njk" %}
{% include "partials/booking.njk" %}
