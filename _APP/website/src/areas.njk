---
layout: layouts/base.njk
permalink: /areas/
title: Areas I cover in East Sussex
description: I visit homes and businesses across Eastbourne, Bexhill, Hastings, St Leonards, Polegate, Hailsham, Pevensey, Westham and Willingdon.
---
<section class="page-hero">
  <div class="container narrow">
    <p class="eyebrow">Areas I cover</p>
    <h1>Areas I cover</h1>
    <p class="lede">I'm based in {{ site.base }} and visit homes and businesses across the surrounding towns and villages. {{ prices.travel }}</p>
  </div>
</section>
<section class="section section-tint" aria-labelledby="map-heading">
  <div class="container">
    <h2 id="map-heading">Coverage map</h2>
    <p class="section-lede">The shaded area shows where I cover. Tap a town's name to see its page.</p>
    <div id="area-map" class="area-map" role="region" aria-label="Map of the towns I cover">
      <noscript><p>The map needs JavaScript. All the towns I cover are listed below.</p></noscript>
    </div>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="card-grid">
      {%- for t in towns %}
      <a class="card card-link" href="/computer-help-{{ t.slug }}/">
        <h3>{{ t.name }}</h3>
        <p class="small">{{ t.postcodes }} · {{ t.travel }}</p>
        <p>{{ t.areas | join(", ") }}</p>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
<section class="section section-tint">
  <div class="container narrow prose">
    <h2>Not on the list? Don't sulk.</h2>
    <p>If you're in a village nearby, such as Herstmonceux, East Dean, Friston, Ninfield or Battle, just ask. I can often fit you in, and I'll let you know if there's a small travel charge before booking.</p>
    <p>Further afield? <a href="/remote-help/">Remote help</a> works anywhere in the UK.</p>
  </div>
</section>
{% include "partials/booking.njk" %}

<link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
<script src="/assets/vendor/leaflet/leaflet.js"></script>
<script>
  // Coverage map: OpenStreetMap tiles, no API key and no cookies. Town positions live in _data/towns.json.
  (function () {
    var el = document.getElementById("area-map");
    if (!el || !window.L) return;
    var towns = [{% for t in towns %}{ name: {{ t.name | dump | safe }}, slug: "{{ t.slug }}", lat: {{ t.lat }}, lng: {{ t.lng }} }{% if not loop.last %}, {% endif %}{% endfor %}];
    var map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    // One coverage area: the outline around a 2.2 km ring of points at each town (convex hull)
    var R = 2200, pts = [];
    towns.forEach(function (t) {
      var dLat = R / 111320, dLng = R / (111320 * Math.cos(t.lat * Math.PI / 180));
      for (var a = 0; a < 360; a += 10) {
        var r = a * Math.PI / 180;
        pts.push([t.lat + dLat * Math.sin(r), t.lng + dLng * Math.cos(r)]);
      }
    });
    pts.sort(function (p, q) { return p[1] - q[1] || p[0] - q[0]; });
    function cross(o, a, b) { return (a[1] - o[1]) * (b[0] - o[0]) - (a[0] - o[0]) * (b[1] - o[1]); }
    var lower = [], upper = [];
    pts.forEach(function (p) { while (lower.length > 1 && cross(lower[lower.length - 2], lower[lower.length - 1], p) <= 0) lower.pop(); lower.push(p); });
    pts.slice().reverse().forEach(function (p) { while (upper.length > 1 && cross(upper[upper.length - 2], upper[upper.length - 1], p) <= 0) upper.pop(); upper.push(p); });
    var hull = lower.slice(0, -1).concat(upper.slice(0, -1));
    var area = L.polygon(hull, { color: "#1f6577", weight: 2, fillColor: "#9cc7cf", fillOpacity: 0.35, interactive: false }).addTo(map);
    function fit() { map.invalidateSize(); map.fitBounds(area.getBounds(), { padding: el.offsetWidth > 600 ? [20, 20] : [45, 10] }); } // extra side room on phones so edge labels fit
    fit();
    // The map can be laid out before the stylesheet gives it a height, so fit again once it has a real size
    if (window.ResizeObserver) new ResizeObserver(fit).observe(el); else window.addEventListener("load", fit);

    var wide = el.offsetWidth > 600;
    towns.forEach(function (t) {
      // Short names, nudged apart where towns sit close together. Tap a name to open that town's page.
      var label = t.name.replace(/-on-Sea$/, "").split(" and ")[0];
      var dir = { westham: "left", pevensey: "right", "st-leonards": "left", hastings: "right", willingdon: "left", polegate: "left" }[t.slug] || "center";
      var tip = L.tooltip({ permanent: true, interactive: true, direction: wide ? dir : "center", className: "map-label" })
        .setLatLng([t.lat, t.lng]).setContent(label).addTo(map);
      tip.getElement().addEventListener("click", function () { window.location.href = "/computer-help-" + t.slug + "/"; });
    });
  })();
</script>
