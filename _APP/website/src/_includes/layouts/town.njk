---
layout: layouts/base.njk
---
{%- set formTown = town.name %}
<section class="hero hero-service">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Local tech help · {{ town.postcodes }}</p>
      <h1>Computer and tech help in {{ town.name }}</h1>
      <p class="lede">{{ town.intro }}</p>
      <div class="btn-row">
        <a href="tel:{{ site.phoneLink }}" class="btn btn-primary">Call {{ site.phone }}</a>
        <a href="#book" class="btn btn-accent">Book a visit in {{ town.name }}</a>
      </div>
      <ul class="chips"><li>{{ town.travel }}</li><li>{{ prices.hourly | gbp }} an hour</li><li>{{ prices.diagnosis }}</li><li>{{ prices.noFixNoFee }}</li><li>Zero jargon</li></ul>
    </div>
  </div>
</section>

<section class="section">
  <div class="container two-col">
    <div class="prose">
      <h2>Your local tech rescue</h2>
      <p>{{ town.local }}</p>
      <p>Every visit starts with a chat about what's wrong. I'll tell you the likely cost before I begin, and if it's something you can fix yourself next time, I'll show you how.</p>
    </div>
    <aside class="info-card">
      <h2 class="h3">Areas I visit</h2>
      <ul class="area-list">{% for a in town.areas %}<li>{{ a }}</li>{% endfor %}</ul>
      <p class="small">Postcodes {{ town.postcodes }}. Not listed? <a href="tel:{{ site.phoneLink }}">Just ask</a>.</p>
    </aside>
  </div>
</section>

<section class="section section-tint" aria-labelledby="fix-heading">
  <div class="container">
    <h2 id="fix-heading">Things I fix in {{ town.name }}</h2>
    <div class="card-grid">
      {%- for f in fixes %}
      <article class="card"><span class="card-icon">{% icon f.icon %}</span><h3>{{ f.title }}</h3><p>{{ f.text }}</p></article>
      {%- endfor %}
    </div>
  </div>
</section>

{% include "partials/steps.njk" %}
{% include "partials/pricing.njk" %}
{% include "partials/reviews.njk" %}

<section class="section" aria-labelledby="nearby-heading">
  <div class="container">
    <h2 id="nearby-heading">Nearby areas I cover</h2>
    <ul class="pill-links">
      {%- for slug in town.nearby %}{% set n = towns | findBySlug(slug) %}{% if n %}<li><a href="/computer-help-{{ n.slug }}/">{{ n.name }}</a></li>{% endif %}{% endfor %}
      <li><a href="/areas/">See all areas</a></li>
    </ul>
  </div>
</section>

{% include "partials/booking.njk" %}
